# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=sync_db

# Google Sign-In (public OAuth client identifier)
GOOGLE_CLIENT_ID=529178437359-vna4bk83lvk9mne5revmh6cfadmi9131.apps.googleusercontent.com

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRATION=7d
# Sal aleatório longo, diferente do JWT_SECRET, usado apenas no hash de CPF.
CPF_HASH_SALT=change-me-with-at-least-32-random-characters

# App
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:8081,https://sync-2-0-blush.vercel.app
PUBLIC_WEB_URL=https://sync-2-0-blush.vercel.app
BACKEND_URL=http://localhost:3000
DB_SSL=false
# Use true somente no primeiro provisionamento; em produção existente, use false.
DB_SYNCHRONIZE=false

# Admin: após aplicar a migration, defina users."isAdmin" = true diretamente
# no Supabase apenas para contas administrativas confiáveis.
# Documentos de verificação: bucket OBRIGATORIAMENTE privado.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_KYC_BUCKET=identity-verification
# Somente desenvolvimento local: habilita o checkout simulado de 30 dias.
# Nunca habilite em produção, pois não representa cobrança real.
SUBSCRIPTION_DEMO=false
# Stripe ainda não está integrado; não libere assinatura real sem webhook verificado.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email verification
# Recomendado no Render Free: Resend pela API HTTPS com domínio verificado
RESEND_API_KEY=
EMAIL_FROM=Sync <noreply@syncapp.site>
# Limite para o provedor não atrasar a resposta do cadastro (milissegundos)
RESEND_TIMEOUT_MS=8000

# Apenas desenvolvimento ou Render pago. Render Free bloqueia portas SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sync.confirmacao@gmail.com
SMTP_PASS=google_app_password_16_chars
# EMAIL_FROM=Sync <sync.confirmacao@gmail.com>
