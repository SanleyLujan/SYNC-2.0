# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=sync_db

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRATION=7d

# App
PORT=3000
NODE_ENV=development
FRONTEND_URL=https://sync-2-0-blush.vercel.app

# Email verification
# Option 1: Resend with verified domain
RESEND_API_KEY=
EMAIL_FROM=Sync <noreply@seudominio.com>

# Option 2: Gmail SMTP with app password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sync.confirmacao@gmail.com
SMTP_PASS=google_app_password_16_chars
# EMAIL_FROM=Sync <sync.confirmacao@gmail.com>
