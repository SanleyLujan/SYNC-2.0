# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=sync_db

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRATION=7d

# App
PORT=3000
NODE_ENV=development
FRONTEND_URL=https://sync-2-0-blush.vercel.app

# Email verification
# Recomendado no Render Free: Resend pela API HTTPS com domínio verificado
RESEND_API_KEY=
EMAIL_FROM=Sync <noreply@seudominio.com>

# Apenas desenvolvimento ou Render pago. Render Free bloqueia portas SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sync.confirmacao@gmail.com
SMTP_PASS=google_app_password_16_chars
# EMAIL_FROM=Sync <sync.confirmacao@gmail.com>
